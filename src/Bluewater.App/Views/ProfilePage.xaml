<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Bluewater.App.ViewModels"
             x:Class="Bluewater.App.Views.ProfilePage"
             x:DataType="viewModels:ProfileViewModel"
             Title="Profile">
    <Grid Padding="24"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="14"
          Background="{StaticResource CollectionBackgroundBrush}">
        <VerticalStackLayout Spacing="4">
            <Label Text="{Binding DisplayName}"
                   FontSize="24"
                   FontAttributes="Bold" />
            <Label Text="{Binding Username, StringFormat='User: {0}'}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                StrokeShape="RoundRectangle 5 5 5 5"
                Padding="16">
            <Grid ColumnDefinitions="*,*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="20"
                  RowSpacing="8">
                <Label Text="{Binding EmailDisplay}" />
                <Label Grid.Column="1"
                       Text="{Binding PositionDisplay}" />
                <Label Grid.Column="2"
                       Text="{Binding DepartmentDisplay}" />
                <Label Grid.Row="1"
                       Text="{Binding SectionDisplay}" />
                <Label Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding TypeLevelDisplay}" />
                <Label Grid.Row="1"
                       Grid.Column="2"
                       Text="{Binding DateHiredDisplay}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="14">
            <CollectionView ItemsSource="{Binding LeaveBalances}">
                <CollectionView.Header>
                    <Label Text="Leave Balance"
                           FontSize="18"
                           FontAttributes="Bold" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ProfileLeaveBalance">
                        <Grid Padding="0,8"
                              ColumnDefinitions="*,Auto">
                            <Label Text="{Binding LeaveCreditName}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Remaining, StringFormat='{}{0:N1}'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView Grid.Column="1"
                            ItemsSource="{Binding FiledForms}">
                <CollectionView.Header>
                    <Label Text="Filed Forms"
                           FontSize="18"
                           FontAttributes="Bold" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ProfileFiledForm">
                        <Grid Padding="0,8"
                              ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto">
                            <Label Text="{Binding Description}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Status}" />
                            <Label Grid.Row="1"
                                   Text="{Binding FormType}"
                                   FontSize="12" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding DateRange}"
                                   FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
